{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRoutedSNS",
      "Effect": "Allow",
      "Principal": {
        "Service": "sns.amazonaws.com"
      },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:619183773524:jobs-queue.fifo",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:sns:us-east-1:619183773524:hcm-routed-events.fifo"
        }
      }
    }
  ]
}